[submodule ".registry"]
	path = .registry
	url = https://github.com/tpetzoldt/tpetzoldt.r-universe.dev
	branch = HEAD
[submodule "FAdist"]
	path = FAdist
	url = https://github.com/tpetzoldt/FAdist
[submodule "FAmle"]
	path = FAmle
	url = https://github.com/tpetzoldt/FAmle
[submodule "FME"]
	path = FME
	url = https://github.com/r-forge/FME
	subdir = pkg/FME
[submodule "antibioticR"]
	path = antibioticR
	url = https://github.com/tpetzoldt/antibioticR
[submodule "biblioview"]
	path = biblioview
	url = https://github.com/tpetzoldt/biblioview
[submodule "cardidates"]
	path = cardidates
	url = https://github.com/tpetzoldt/cardidates
[submodule "deSolve"]
	path = deSolve
	url = https://github.com/tpetzoldt/deSolve
[submodule "growthrates"]
	path = growthrates
	url = https://github.com/tpetzoldt/growthrates
[submodule "marelac"]
	path = marelac
	url = https://github.com/r-forge/marelac
	subdir = pkg/marelac
[submodule "proto"]
	path = proto
	url = https://github.com/hadley/proto
[submodule "qualV"]
	path = qualV
	url = https://github.com/tpetzoldt/qualV
[submodule "salmoRodeo"]
	path = salmoRodeo
	url = https://github.com/tpetzoldt/salmoRodeo
[submodule "simecol"]
	path = simecol
	url = https://github.com/tpetzoldt/simecol
